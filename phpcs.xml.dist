<?xml version="1.0"?>
<ruleset name="ELAN AI Bridge for Drupal">
  <description>Drupal coding standards for the ELAN AI Bridge module.</description>

  <file>.</file>
  <exclude-pattern>vendor/*</exclude-pattern>
  <exclude-pattern>build/*</exclude-pattern>
  <exclude-pattern>dist/*</exclude-pattern>

  <arg name="extensions" value="php,module,install"/>
  <arg name="basepath" value="."/>
  <arg value="ps"/>
  <arg name="parallel" value="8"/>

  <rule ref="Drupal"/>
  <rule ref="DrupalPractice"/>
</ruleset>
