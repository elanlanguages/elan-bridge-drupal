{
  "name": "elan/elan-bridge-drupal",
  "description": "TMGMT connector for the ELAN AI Bridge translation pipeline.",
  "keywords": [
    "drupal",
    "tmgmt",
    "translation"
  ],
  "type": "drupal-module",
  "license": "proprietary",
  "homepage": "https://github.com/elanlanguages/elan-bridge-drupal",
  "support": {
    "issues": "https://github.com/elanlanguages/elan-bridge-drupal/issues",
    "source": "https://github.com/elanlanguages/elan-bridge-drupal"
  },
  "repositories": [
    {
      "type": "composer",
      "url": "https://packages.drupal.org/8"
    }
  ],
  "require": {
    "php": ">=8.1",
    "drupal/core": "^10.3 || ^11",
    "drupal/key": "^1.22",
    "drupal/tmgmt": "^1.17"
  },
  "require-dev": {
    "drupal/coder": "^8.3",
    "drupal/core-dev": "^10.3 || ^11"
  },
  "autoload": {
    "psr-4": {
      "Drupal\\elan_bridge\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Drupal\\key\\": "vendor/drupal/key/src/",
      "Drupal\\sqlite\\": "vendor/drupal/core/modules/sqlite/src/",
      "Drupal\\Tests\\elan_bridge\\": "tests/src/",
      "Drupal\\tmgmt\\": "vendor/drupal/tmgmt/src/"
    }
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "drupal/core-composer-scaffold": false,
      "php-http/discovery": true,
      "phpstan/extension-installer": true,
      "symfony/runtime": false,
      "tbachert/spi": true
    },
    "sort-packages": true
  },
  "extra": {
    "installer-name": "elan_bridge"
  },
  "scripts": {
    "lint": "phpcs",
    "lint:fix": "phpcbf",
    "test": "phpunit -c phpunit.xml.dist",
    "check": [
      "@lint",
      "@test"
    ]
  }
}
